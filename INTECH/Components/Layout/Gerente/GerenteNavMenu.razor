<nav class="tecnico-nav nav flex-column" aria-label="Menú del gerente">
    <div class="nav-item px-3 pt-3 pb-2">
        <NavLink class="nav-link d-flex align-items-center" href="/Gerente/Inicio" Match="NavLinkMatch.All">
            <span class="bi bi-house-door text-primary" aria-hidden="true"></span> Inicio
        </NavLink>
    </div>
    <div class="nav-item px-3 pb-3">
        <NavLink class="nav-link d-flex align-items-center" href="/Servicio/Index">
            <span class="bi bi-tools text-primary" aria-hidden="true"></span> Servicios
        </NavLink>
    </div>
</nav>

<div class="flex-grow-1"></div>

<AuthorizeView>
    <Authorized>
        <div class="tecnico-nav-user border-top p-3 d-flex flex-column gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="rounded-circle bg-primary bg-opacity-10 p-2 d-flex align-items-center justify-content-center flex-shrink-0" aria-hidden="true">
                    <span class="bi bi-person text-primary fs-4 lh-1 d-flex"></span>
                </span>
                <div class="d-flex flex-column">
                    <span class="fw-bold">@(context.User.FindFirst("NombreCompleto")?.Value ?? context.User.Identity?.Name)</span>
                    <small class="text-body-secondary">Gerente</small>
                </div>
            </div>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="" />
                <button type="submit" class="btn btn-outline-danger w-100 d-flex justify-content-center align-items-center gap-2">
                    <span class="bi bi-box-arrow-left" aria-hidden="true"></span> Cerrar sesión
                </button>
            </form>
        </div>
    </Authorized>
</AuthorizeView>
