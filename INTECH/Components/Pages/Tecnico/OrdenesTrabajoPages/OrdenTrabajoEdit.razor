@page "/OrdenTrabajo/Edit/{OrdenTrabajoId:int}"
@attribute [Authorize(Roles = "Técnico")]

@inject OrdenesTrabajoService ordenesTrabajoService
@inject SolicitudesService solicitudesService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Orden de Trabajo</PageTitle>
<EditForm Model="OrdenTrabajo" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Orden de Trabajo</h5>
            </div>

            <div class="card-body">

                @* Solicitud *@
                <div class="mb-3">
                    <label class="form-label"><strong>Solicitud</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="OrdenTrabajo.SolicitudId">
                        <option value="0" disabled>Elija una Solicitud</option>
                        @foreach (var solicitud in ListaSolicitudes)
                        {
                            <option value="@solicitud.SolicitudId">Solicitud #@solicitud.SolicitudId - @solicitud.Cliente.Nombre (@string.Join(", ", solicitud.SolicitudesDetalle.Select(detalle => detalle.Servicio.Nombre)))</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => OrdenTrabajo.SolicitudId)" />
                </div>

                @* Tareas a realizar *@
                <div class="mb-3">
                    <label class="form-label"><strong>Tareas a realizar (Checklist técnico)</strong></label>
                    <InputTextArea class="form-control" @bind-Value="OrdenTrabajo.Tareas" placeholder="Ej.: 1. Inspección y preparación, 2. Instalación de materiales, 3. Pruebas eléctricas"></InputTextArea>
                    <ValidationMessage For="(() => OrdenTrabajo.Tareas)" />
                </div>

                @* Materiales de la cotización *@
                <div class="mb-3">
                    <label class="form-label"><strong>Materiales de la cotización</strong></label>
                    <InputTextArea class="form-control" @bind-Value="OrdenTrabajo.Materiales" placeholder="Ej.: UPS 6 kVA x 3, Batería 12V 120Ah x 2"></InputTextArea>
                    <ValidationMessage For="(() => OrdenTrabajo.Materiales)" />
                </div>

                @* Instrucciones de campo *@
                <div class="mb-3">
                    <label class="form-label"><strong>Instrucciones de campo</strong></label>
                    <InputTextArea class="form-control" @bind-Value="OrdenTrabajo.InstruccionesCampo" placeholder="Ej.: Coordinar el acceso con el cliente y documentar las pruebas de funcionamiento."></InputTextArea>
                </div>

            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/OrdenTrabajo/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminarOrdenTrabajo"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarOrdenTrabajo" tabindex="-1" aria-labelledby="modalEliminarOrdenTrabajoLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarOrdenTrabajoLabel">Eliminar Orden de Trabajo</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar esta orden de trabajo?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    [Parameter]
    public int OrdenTrabajoId { get; set; }

    public OrdenesTrabajo OrdenTrabajo { get; set; } = new OrdenesTrabajo();
    public List<Solicitudes> ListaSolicitudes { get; set; } = new List<Solicitudes>();

    protected override async Task OnInitializedAsync()
    {
        var result = await ordenesTrabajoService.Buscar(OrdenTrabajoId);
        result.OnSuccess(orden => OrdenTrabajo = orden ?? new OrdenesTrabajo());

        var solicitudesResult = await solicitudesService.GetList(s => true);
        solicitudesResult.OnSuccess(solicitudes => ListaSolicitudes = solicitudes);
        solicitudesResult.OnFailure(() => toastService.ShowError("No se pudieron consultar las solicitudes."));
    }

    public async Task Modificar()
    {
        var solicitud = ListaSolicitudes.FirstOrDefault(s => s.SolicitudId == OrdenTrabajo.SolicitudId);
        if ((solicitud?.EstadoSolicitudId ?? OrdenTrabajo.Solicitud?.EstadoSolicitudId) == 9)
        {
            toastService.ShowError("No se puede modificar una orden de trabajo cuya solicitud está finalizada.");
            return;
        }

        OrdenTrabajo.Tareas = OrdenTrabajo.Tareas.Trim();
        OrdenTrabajo.Materiales = OrdenTrabajo.Materiales.Trim();
        OrdenTrabajo.InstruccionesCampo = OrdenTrabajo.InstruccionesCampo.Trim();

        var result = await ordenesTrabajoService.Guardar(OrdenTrabajo);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Orden de trabajo modificada correctamente.");
            navigationManager.NavigateTo("/OrdenTrabajo/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo modificar la orden de trabajo."));
    }

    private async Task Eliminar()
    {
        var solicitud = ListaSolicitudes.FirstOrDefault(s => s.SolicitudId == OrdenTrabajo.SolicitudId);
        var estadoSolicitudId = solicitud?.EstadoSolicitudId ?? OrdenTrabajo.Solicitud?.EstadoSolicitudId;
        if (estadoSolicitudId == 8 || estadoSolicitudId == 9)
        {
            toastService.ShowError("No se puede eliminar una orden de trabajo pendiente de cobro o finalizada.");
            return;
        }

        var result = await ordenesTrabajoService.Eliminar(OrdenTrabajoId);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Orden de trabajo eliminada correctamente.");
            navigationManager.NavigateTo("/OrdenTrabajo/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar la orden de trabajo."));
    }
}
