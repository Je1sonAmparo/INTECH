@page "/Solicitud/Create"
@attribute [Authorize(Roles = "Técnico")]

@inject SolicitudesService solicitudesService
@inject ClientesService clientesService
@inject ServiciosService serviciosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Crear Solicitud</PageTitle>
<EditForm Model="Solicitud" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Crear Solicitud</h5>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    @* Cliente *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><strong>Cliente</strong></label>
                        <InputSelect class="form-control form-select" @bind-Value="Solicitud.ClienteId" @bind-Value:after="CargarDireccion">
                            <option value="0" selected disabled>Elija un Cliente</option>
                            @foreach (var cliente in ListaClientes)
                            {
                                <option value="@cliente.ClienteId">@cliente.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="(() => Solicitud.ClienteId)" />
                    </div>

                    @* Fecha de Solicitud *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><strong>Fecha de Solicitud</strong></label>
                        <InputDate class="form-control" @bind-Value="Solicitud.FechaSolicitud"></InputDate>
                        <ValidationMessage For="(() => Solicitud.FechaSolicitud)" />
                    </div>
                </div>

                @* Dirección del Servicio *@
                <div class="mb-3">
                    <label class="form-label"><strong>Dirección del Servicio</strong></label>
                    <InputText class="form-control" @bind-Value="Solicitud.Direccion" placeholder="Ej.: Calle Principal #12, Santiago"></InputText>
                    <ValidationMessage For="(() => Solicitud.Direccion)" />
                </div>

                @* Observaciones del Cliente *@
                <div class="mb-3">
                    <label class="form-label"><strong>Observaciones del Cliente</strong></label>
                    <InputTextArea class="form-control" @bind-Value="Solicitud.ObservacionesCliente" placeholder="Ej.: Desea que el trabajo se realice en horario nocturno y que se deje el área limpia."></InputTextArea>
                    <ValidationMessage For="(() => Solicitud.ObservacionesCliente)" />
                </div>

                @* Detalles de la Solicitud *@
                <div class="border border-success p-3 mt-3">
                    <h5>Detalles de la Solicitud</h5>

                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label"><strong>Servicio</strong></label>
                            <InputSelect class="form-control form-select" @bind-Value="DetalleSeleccionado.ServicioId">
                                <option value="0" selected disabled>Elija un servicio</option>
                                @foreach (var servicio in ListaServicios.Where(s => s.Activo))
                                {
                                    <option value="@servicio.ServicioId">@servicio.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label"><strong>Cantidad</strong></label>
                            <InputNumber class="form-control" @bind-Value="DetalleSeleccionado.Cantidad" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-outline-success w-100" @onclick="AgregarDetalle">
                                <span class="bi bi-plus-lg"></span> Agregar
                            </button>
                        </div>
                    </div>
                    <hr />
                    <table class="table table-light">
                        <thead class="table table-striped">
                            <tr class="Text-center">
                                <th>Servicio</th>
                                <th>Cantidad</th>
                                <th>Remover</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in Solicitud.SolicitudesDetalle)
                            {
                                <tr>
                                    <td>@ListaServicios.FirstOrDefault(servicio => servicio.ServicioId == detalle.ServicioId)?.Nombre</td>
                                    <td>@detalle.Cantidad</td>
                                    <td>
                                        <button type="button" class="btn btn-outline-danger bi bi-trash"
                                                @onclick="() => RemoverDetalle(detalle)"></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Total *@
                <div class="row">
                    <div class="col-6 offset-6">
                        <div class="mb-3">
                            <label class="form-label"><strong>Total de servicios</strong></label>
                            <label class="form-control text-end"><strong>@Solicitud.SolicitudesDetalle.Sum(detalle => detalle.Cantidad).ToString("N0")</strong></label>
                        </div>
                    </div>
                </div>
            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Solicitud/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public Solicitudes Solicitud { get; set; } = new Solicitudes();
    public SolicitudesDetalle DetalleSeleccionado { get; set; } = new SolicitudesDetalle();
    public List<Clientes> ListaClientes { get; set; } = new List<Clientes>();
    public List<Servicios> ListaServicios { get; set; } = new List<Servicios>();

    protected override async Task OnInitializedAsync()
    {
        var clientesResult = await clientesService.GetList(c => true);
        clientesResult.OnSuccess(clientes => ListaClientes = clientes);
        clientesResult.OnFailure(() => toastService.ShowError("No se pudieron consultar los clientes."));

        var serviciosResult = await serviciosService.GetList(s => true);
        serviciosResult.OnSuccess(servicios => ListaServicios = servicios);
        serviciosResult.OnFailure(() => toastService.ShowError("No se pudieron consultar los servicios."));
    }

    private void CargarDireccion()
    {
        var cliente = ListaClientes.FirstOrDefault(c => c.ClienteId == Solicitud.ClienteId);
        if (cliente != null && Solicitud.Direccion.Trim() == "")
        {
            Solicitud.Direccion = cliente.Direccion;
        }
    }

    private void AgregarDetalle()
    {
        var servicioSeleccionado = ListaServicios.FirstOrDefault(servicio => servicio.ServicioId == DetalleSeleccionado.ServicioId);
        if (servicioSeleccionado == null)
        {
            toastService.ShowError("Seleccione un servicio.");
            return;
        }

        if (DetalleSeleccionado.Cantidad <= 0)
        {
            toastService.ShowError("La cantidad debe ser mayor que cero.");
            return;
        }

        if (Solicitud.SolicitudesDetalle.Any(detalle => detalle.ServicioId == servicioSeleccionado.ServicioId))
        {
            toastService.ShowError("Ese servicio ya está en la solicitud.");
            return;
        }

        Solicitud.SolicitudesDetalle.Add(new SolicitudesDetalle
        {
            ServicioId = servicioSeleccionado.ServicioId,
            Cantidad = DetalleSeleccionado.Cantidad
        });

        DetalleSeleccionado = new SolicitudesDetalle();
    }

    private void RemoverDetalle(SolicitudesDetalle detalle)
    {
        Solicitud.SolicitudesDetalle.Remove(detalle);
    }

    public async Task Guardar()
    {
        if (Solicitud.SolicitudesDetalle.Count == 0)
        {
            toastService.ShowError("Agregue al menos un servicio a la solicitud.");
            return;
        }

        Solicitud.Direccion = Solicitud.Direccion.Trim();
        Solicitud.ObservacionesCliente = Solicitud.ObservacionesCliente.Trim();

        var creadoResult = await solicitudesService.Guardar(Solicitud);
        creadoResult.OnSuccess(() =>
        {
            toastService.ShowSuccess("Solicitud guardada correctamente.");
            navigationManager.NavigateTo("/Solicitud/Index");
        });
        creadoResult.OnFailure(() => toastService.ShowError("No se pudo guardar la solicitud."));
    }
}
