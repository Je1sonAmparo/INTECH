@page "/Levantamiento/Index"
@attribute [Authorize(Roles = "Técnico")]

@inject LevantamientosService levantamientosService
@inject EstadosSolicitudesService estadosSolicitudesService
@inject Microsoft.AspNetCore.Identity.UserManager<INTECH.Data.ApplicationUser> userManager
@inject ServiciosService serviciosService
@inject ToastService toastService

<PageTitle>Registro de Levantamientos</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Levantamientos</h5>
            <a href="/Levantamiento/Create" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear Levantamiento</a>
        </div>

        <div class="card-body">
            @* Filtro *@
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>Búsqueda</strong></label>
                </div>
            </div>

            @* Controles de búsqueda *@
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="LevantamientoId">LevantamientoId</option>
                        <option value="SolicitudId">SolicitudId</option>
                        <option value="Cliente">Cliente</option>
                        <option value="Servicio">Servicio</option>
                        <option value="Fecha">Fecha Programada</option>
                        <option value="Estado">Estado</option>
                        <option value="Tecnico">Técnico</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-2">
                    <label class="col-form-label"><strong>Desde</strong></label>
                    <InputDate class="form-control" @bind-Value="Desde"></InputDate>
                </div>
                <div class="col-2">
                    <label class="col-form-label"><strong>Hasta</strong></label>
                    <InputDate class="form-control" @bind-Value="Hasta"></InputDate>
                </div>
                <div class="col-3">
                    <label class="col-form-label"><strong>Servicio</strong></label>
                    <InputSelect class="form-select" @bind-Value="ServicioFiltroId">
                        <option value="0">Todos</option>
                        @foreach (var servicio in ListaServicios)
                        {
                            <option value="@servicio.ServicioId">@servicio.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-3">
                    <label class="col-form-label"><strong>Estado</strong></label>
                    <InputSelect class="form-select" @bind-Value="EstadoFiltroId">
                        <option value="0">Todos</option>
                        @foreach (var estadoSolicitud in ListaEstadosSolicitudes)
                        {
                            <option value="@estadoSolicitud.EstadoSolicitudId">@estadoSolicitud.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-2">
                    <label class="col-form-label"><strong>Técnico</strong></label>
                    <InputSelect class="form-select" @bind-Value="TecnicoFiltroId">
                        <option value="">Todos</option>
                        <option value="SIN_ASIGNAR">Sin asignar</option>
                        @foreach (var tecnico in ListaTecnicos)
                        {
                            <option value="@tecnico.Id">@tecnico.UserName</option>
                        }
                    </InputSelect>
                </div>
            </div>

            @* Tabla *@
            <div class="grid">
                <QuickGrid Items="ListaLevantamientos.AsQueryable()" Class="table table-hover mt-3">
                    <PropertyColumn Property="@(l => l.LevantamientoId)" Title="LevantamientoId" Sortable="true" />
                    <TemplateColumn Title="Solicitud" Sortable="true" SortBy="@(GridSort<Levantamientos>.ByAscending(l => l.SolicitudId))">
                        Solicitud #@context.SolicitudId
                    </TemplateColumn>
                    <PropertyColumn Property="@(l => l.Solicitud.Cliente.Nombre)" Title="Cliente" Sortable="true" />
                    <TemplateColumn Title="Servicios">
                        @string.Join(", ", context.Solicitud.SolicitudesDetalle.Select(detalle => detalle.Servicio.Nombre))
                    </TemplateColumn>
                    <TemplateColumn Title="Fecha Programada">
                        @context.FechaProgramada.ToString("dd/MM/yyyy") · @context.HoraInicio.ToString("hh:mm tt") - @context.HoraFin.ToString("hh:mm tt")
                    </TemplateColumn>
                    <TemplateColumn Title="Técnico">
                        @ObtenerNombreTecnico(context.TecnicoId)
                    </TemplateColumn>
                    <TemplateColumn Title="Estado">
                        <div class="d-flex flex-column align-items-start gap-1">
                            <span class="badge @ObtenerColorEstado(context.Solicitud.EstadoSolicitudId)">@context.Solicitud.EstadoSolicitud.Nombre</span>
                            @if (context.EsBorrador)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis">Borrador guardado</span>
                            }
                        </div>
                    </TemplateColumn>
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <div class="d-flex text-nowrap">
                            <a href="/Levantamiento/Iniciar/@context.LevantamientoId" class="btn btn-outline-primary">Iniciar levantamiento</a>
                            <a href="/Levantamiento/Edit/@context.LevantamientoId" class="btn btn-outline-primary bi bi-pencil-square ms-2"></a>
                            <button type="button" class="btn btn-outline-danger bi bi-trash ms-2"
                                    data-bs-toggle="modal" data-bs-target="#modalEliminarLevantamiento"
                                    @onclick="() => levantamientoIdAEliminar = context.LevantamientoId"></button>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @ListaLevantamientos.Count</label>
        </div>
    </div>
</div>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarLevantamiento" tabindex="-1" aria-labelledby="modalEliminarLevantamientoLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarLevantamientoLabel">Eliminar Levantamiento</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar este levantamiento?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    public List<Servicios> ListaServicios { get; set; } = new List<Servicios>();
    public List<Levantamientos> ListaLevantamientos { get; set; } = new List<Levantamientos>();
    public List<EstadosSolicitudes> ListaEstadosSolicitudes { get; set; } = new List<EstadosSolicitudes>();
    public List<INTECH.Data.ApplicationUser> ListaTecnicos { get; set; } = new List<INTECH.Data.ApplicationUser>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public DateTime? Desde { get; set; }
    public DateTime? Hasta { get; set; }
    public int ServicioFiltroId { get; set; }
    public int EstadoFiltroId { get; set; }
    public string TecnicoFiltroId { get; set; } = string.Empty;
    private int levantamientoIdAEliminar;

    protected override async Task OnInitializedAsync()
    {
        var serviciosResult = await serviciosService.GetList(s => true);
        serviciosResult.OnSuccess(servicios => ListaServicios = servicios);
        serviciosResult.OnFailure(() => toastService.ShowError("No se pudieron consultar los servicios."));

        var estadosSolicitudesResult = await estadosSolicitudesService.GetList(e => true);
        estadosSolicitudesResult.OnSuccess(estadosSolicitudes => ListaEstadosSolicitudes = estadosSolicitudes);
        estadosSolicitudesResult.OnFailure(() => toastService.ShowError("No se pudieron consultar los estados."));

        var tecnicos = await userManager.GetUsersInRoleAsync("Técnico");
        ListaTecnicos = tecnicos.ToList();

        await CargarLevantamientos();
        Desde = null;
        Hasta = null;
    }

    private async Task CargarLevantamientos()
    {
        var levantamientosResult = await levantamientosService.GetList(l => true);
        levantamientosResult.OnSuccess(levantamientos => ListaLevantamientos = levantamientos);
        levantamientosResult.OnFailure(() => toastService.ShowError("No se pudieron consultar los levantamientos."));
    }

    private string ObtenerNombreTecnico(string? tecnicoId)
    {
        if (string.IsNullOrWhiteSpace(tecnicoId))
        {
            return "Sin asignar";
        }

        return ListaTecnicos.FirstOrDefault(t => t.Id == tecnicoId)?.UserName ?? "Sin asignar";
    }

    private string ObtenerColorEstado(int estadoSolicitudId)
    {
        if (estadoSolicitudId == 1)
        {
            return "bg-warning-subtle text-warning-emphasis";
        }
        else if (estadoSolicitudId == 2)
        {
            return "bg-primary-subtle text-primary-emphasis";
        }
        else if (estadoSolicitudId == 3)
        {
            return "bg-primary bg-opacity-10 text-primary";
        }
        else if (estadoSolicitudId == 5)
        {
            return "bg-warning-subtle text-danger-emphasis";
        }
        else if (estadoSolicitudId == 9)
        {
            return "bg-success-subtle text-success-emphasis";
        }

        return "bg-danger-subtle text-danger-emphasis";
    }

    private async Task Eliminar()
    {
        var levantamiento = ListaLevantamientos.FirstOrDefault(l => l.LevantamientoId == levantamientoIdAEliminar);
        if (levantamiento != null && (levantamiento.Solicitud.EstadoSolicitudId == 2 || levantamiento.Solicitud.EstadoSolicitudId == 3 || levantamiento.Solicitud.EstadoSolicitudId == 9))
        {
            toastService.ShowError("No se puede eliminar un levantamiento cuya solicitud está en proceso, en espera de administración o finalizada.");
            return;
        }

        var result = await levantamientosService.Eliminar(levantamientoIdAEliminar);
        result.OnSuccess(() => toastService.ShowSuccess("Levantamiento eliminado correctamente."));
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar el levantamiento."));

        if (result.IsSuccess)
        {
            await CargarLevantamientos();
        }
    }

    private async Task Buscar()
    {
        var valor = ValorFiltro.Trim().ToLower();
        if (Filtro == "Fecha")
        {
            if (Desde == null || Hasta == null)
            {
                toastService.ShowError("Seleccione las fechas desde y hasta.");
                return;
            }

            if (Desde > Hasta)
            {
                toastService.ShowWarning("La fecha desde no puede ser mayor que la fecha hasta.");
                return;
            }

            var levantamientosPorFechaResult = await levantamientosService.GetList(l =>
                l.FechaProgramada >= Desde && l.FechaProgramada <= Hasta);
            levantamientosPorFechaResult.OnSuccess(levantamientos => ListaLevantamientos = levantamientos);
            levantamientosPorFechaResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar los levantamientos."));
        }
        else if (Filtro == "Estado")
        {
            if (EstadoFiltroId == 0)
            {
                await CargarLevantamientos();
                return;
            }

            var levantamientosPorEstadoResult = await levantamientosService.GetList(l => l.Solicitud.EstadoSolicitudId == EstadoFiltroId);
            levantamientosPorEstadoResult.OnSuccess(levantamientos => ListaLevantamientos = levantamientos);
            levantamientosPorEstadoResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar los levantamientos."));
        }
        else if (Filtro == "Servicio")
        {
            if (ServicioFiltroId != 0)
            {
                var levantamientosPorServicioResult = await levantamientosService.GetList(l => l.Solicitud.SolicitudesDetalle.Any(detalle => detalle.ServicioId == ServicioFiltroId));
                levantamientosPorServicioResult.OnSuccess(levantamientos => ListaLevantamientos = levantamientos);
                levantamientosPorServicioResult.OnFailure(() =>
                    toastService.ShowError("No se pudieron consultar los levantamientos."));
            }
            else if (valor != "")
            {
                var levantamientosPorServicioResult = await levantamientosService.GetList(l => l.Solicitud.SolicitudesDetalle.Any(detalle => detalle.Servicio.Nombre.ToLower().Contains(valor)));
                levantamientosPorServicioResult.OnSuccess(levantamientos => ListaLevantamientos = levantamientos);
                levantamientosPorServicioResult.OnFailure(() =>
                    toastService.ShowError("No se pudieron consultar los levantamientos."));
            }
            else
            {
                await CargarLevantamientos();
            }
        }
        else if (Filtro == "Tecnico")
        {
            if (TecnicoFiltroId == "")
            {
                await CargarLevantamientos();
                return;
            }
            else if (TecnicoFiltroId == "SIN_ASIGNAR")
            {
                var levantamientosSinTecnicoResult = await levantamientosService.GetList(l => string.IsNullOrEmpty(l.TecnicoId));
                levantamientosSinTecnicoResult.OnSuccess(levantamientos => ListaLevantamientos = levantamientos);
                levantamientosSinTecnicoResult.OnFailure(() =>
                    toastService.ShowError("No se pudieron consultar los levantamientos."));
                return;
            }

            var levantamientosPorTecnicoResult = await levantamientosService.GetList(l => l.TecnicoId == TecnicoFiltroId);
            levantamientosPorTecnicoResult.OnSuccess(levantamientos => ListaLevantamientos = levantamientos);
            levantamientosPorTecnicoResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar los levantamientos."));
        }
        else if (valor == "")
        {
            await CargarLevantamientos();
        }
        else if (Filtro == "LevantamientoId")
        {
            if (!int.TryParse(valor, out var levantamientoId))
            {
                toastService.ShowError("Ingrese un número de levantamiento válido.");
                return;
            }

            var levantamientosPorIdResult = await levantamientosService.GetList(l => l.LevantamientoId == levantamientoId);
            levantamientosPorIdResult.OnSuccess(levantamientos => ListaLevantamientos = levantamientos);
            levantamientosPorIdResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar los levantamientos."));
        }
        else if (Filtro == "SolicitudId")
        {
            if (!int.TryParse(valor, out var solicitudId))
            {
                toastService.ShowError("Ingrese un número de solicitud válido.");
                return;
            }

            var levantamientosPorSolicitudResult = await levantamientosService.GetList(l => l.SolicitudId == solicitudId);
            levantamientosPorSolicitudResult.OnSuccess(levantamientos => ListaLevantamientos = levantamientos);
            levantamientosPorSolicitudResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar los levantamientos."));
        }
        else if (Filtro == "Cliente")
        {
            var levantamientosPorClienteResult = await levantamientosService.GetList(l => l.Solicitud.Cliente.Nombre.ToLower().Contains(valor));
            levantamientosPorClienteResult.OnSuccess(levantamientos => ListaLevantamientos = levantamientos);
            levantamientosPorClienteResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar los levantamientos."));
        }
        else
        {
            toastService.ShowError("Seleccione un filtro.");
        }
    }
}
