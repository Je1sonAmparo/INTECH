@page "/Levantamiento/Edit/{LevantamientoId:int}"
@attribute [Authorize(Roles = "Técnico")]

@inject LevantamientosService levantamientosService
@inject SolicitudesService solicitudesService
@inject Microsoft.AspNetCore.Identity.UserManager<INTECH.Data.ApplicationUser> userManager
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Levantamiento</PageTitle>
<EditForm Model="Levantamiento" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Levantamiento</h5>
            </div>

            <div class="card-body">

                @* Solicitud *@
                <div class="mb-3">
                    <label class="form-label"><strong>Solicitud</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Levantamiento.SolicitudId">
                        <option value="0" disabled>Elija una Solicitud</option>
                        @foreach (var solicitud in ListaSolicitudes)
                        {
                            <option value="@solicitud.SolicitudId">Solicitud #@solicitud.SolicitudId - @solicitud.Cliente.Nombre (@string.Join(", ", solicitud.SolicitudesDetalle.Select(detalle => detalle.Servicio.Nombre)))</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Levantamiento.SolicitudId)" />
                </div>

                @* Técnico Asignado *@
                <div class="mb-3">
                    <label class="form-label"><strong>Técnico Asignado</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Levantamiento.TecnicoId">
                        <option value="">Sin asignar</option>
                        @foreach (var tecnico in ListaTecnicos)
                        {
                            <option value="@tecnico.Id">@tecnico.UserName</option>
                        }
                    </InputSelect>
                </div>

                @* Fecha Programada *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha Programada</strong></label>
                    <InputDate class="form-control" @bind-Value="Levantamiento.FechaProgramada"></InputDate>
                    <ValidationMessage For="(() => Levantamiento.FechaProgramada)" />
                </div>

                @* Hora de Inicio *@
                <div class="mb-3">
                    <label class="form-label"><strong>Hora de Inicio</strong></label>
                    <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="Levantamiento.HoraInicio"></InputDate>
                    <ValidationMessage For="(() => Levantamiento.HoraInicio)" />
                </div>

                @* Hora de Fin *@
                <div class="mb-3">
                    <label class="form-label"><strong>Hora de Fin</strong></label>
                    <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="Levantamiento.HoraFin"></InputDate>
                    <ValidationMessage For="(() => Levantamiento.HoraFin)" />
                </div>

            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Levantamiento/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminarLevantamiento"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarLevantamiento" tabindex="-1" aria-labelledby="modalEliminarLevantamientoLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarLevantamientoLabel">Eliminar Levantamiento</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar este levantamiento?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    [Parameter]
    public int LevantamientoId { get; set; }

    public Levantamientos Levantamiento { get; set; } = new Levantamientos();
    public List<Solicitudes> ListaSolicitudes { get; set; } = new List<Solicitudes>();
    public List<INTECH.Data.ApplicationUser> ListaTecnicos { get; set; } = new List<INTECH.Data.ApplicationUser>();

    protected override async Task OnInitializedAsync()
    {
        var result = await levantamientosService.Buscar(LevantamientoId);
        result.OnSuccess(levantamiento => Levantamiento = levantamiento ?? new Levantamientos());

        var solicitudesResult = await solicitudesService.GetList(s => true);
        solicitudesResult.OnSuccess(solicitudes => ListaSolicitudes = solicitudes);
        solicitudesResult.OnFailure(() => toastService.ShowError("No se pudieron consultar las solicitudes."));

        var tecnicos = await userManager.GetUsersInRoleAsync("Técnico");
        ListaTecnicos = tecnicos.ToList();
    }

    public async Task Modificar()
    {
        if (string.IsNullOrWhiteSpace(Levantamiento.TecnicoId))
        {
            Levantamiento.TecnicoId = null;
        }

        if (Levantamiento.FechaProgramada.DayOfWeek == DayOfWeek.Sunday)
        {
            toastService.ShowError("No se pueden programar levantamientos los domingos.");
            return;
        }

        if (Levantamiento.HoraInicio < new TimeOnly(8, 0) || Levantamiento.HoraFin > new TimeOnly(18, 0))
        {
            toastService.ShowError("El horario permitido es de 08:00 AM a 06:00 PM.");
            return;
        }

        if (Levantamiento.HoraFin <= Levantamiento.HoraInicio)
        {
            toastService.ShowError("La hora de fin debe ser mayor que la hora de inicio.");
            return;
        }

        var solicitud = ListaSolicitudes.FirstOrDefault(s => s.SolicitudId == Levantamiento.SolicitudId);
        var estadoSolicitudId = solicitud?.EstadoSolicitudId ?? Levantamiento.Solicitud?.EstadoSolicitudId;
        if (estadoSolicitudId == 9 || estadoSolicitudId == 10)
        {
            toastService.ShowError("No se puede modificar un levantamiento de una solicitud finalizada o cancelada.");
            return;
        }

        var levantamientosMismaSolicitudResult = await levantamientosService.GetList(l => l.SolicitudId == Levantamiento.SolicitudId && l.LevantamientoId != Levantamiento.LevantamientoId);
        var levantamientoYaExiste = false;
        levantamientosMismaSolicitudResult.OnSuccess(lista => levantamientoYaExiste = lista.Any());
        if (levantamientoYaExiste)
        {
            toastService.ShowError("La solicitud seleccionada ya tiene un levantamiento asignado.");
            return;
        }

        var result = await levantamientosService.Guardar(Levantamiento);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Levantamiento modificado correctamente.");
            navigationManager.NavigateTo("/Levantamiento/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo modificar el levantamiento."));
    }

    private async Task Eliminar()
    {
        var solicitud = ListaSolicitudes.FirstOrDefault(s => s.SolicitudId == Levantamiento.SolicitudId);
        var estadoSolicitudId = solicitud?.EstadoSolicitudId ?? Levantamiento.Solicitud?.EstadoSolicitudId;
        if (estadoSolicitudId == 2 || estadoSolicitudId == 3 || estadoSolicitudId == 9)
        {
            toastService.ShowError("No se puede eliminar un levantamiento cuya solicitud está en proceso, en espera de administración o finalizada.");
            return;
        }

        var result = await levantamientosService.Eliminar(LevantamientoId);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Levantamiento eliminado correctamente.");
            navigationManager.NavigateTo("/Levantamiento/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar el levantamiento."));
    }
}
