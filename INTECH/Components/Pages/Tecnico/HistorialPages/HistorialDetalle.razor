@page "/Historial/Detalle/{HistorialId:int}"
@attribute [Authorize(Roles = "Técnico")]

@inject HistorialesService historialesService
@inject Microsoft.AspNetCore.Identity.UserManager<INTECH.Data.ApplicationUser> userManager
@inject ToastService toastService

<PageTitle>Detalle de Historial</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-3">
            <div>
                <h5 class="card-title mb-0">Detalle de Historial</h5>
                <small class="text-body-secondary">Historial #@Historial.HistorialId · Solicitud #@Historial.SolicitudId</small>
            </div>
            <a href="/Historial/Index" class="btn btn-outline-secondary btn-sm bi bi-x-lg"></a>
        </div>

        <div class="card-body">
            @* Información General *@
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <div class="p-3 bg-light border rounded h-100">
                        <small class="text-body-secondary text-uppercase d-block">Cliente</small>
                        <strong>@Historial.Solicitud?.Cliente?.Nombre</strong>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="p-3 bg-light border rounded h-100">
                        <small class="text-body-secondary text-uppercase d-block">Tipo de Servicio</small>
                        <strong>@(Historial.Solicitud == null ? "" : string.Join(", ", Historial.Solicitud.SolicitudesDetalle.Select(detalle => detalle.Servicio.Nombre)))</strong>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="p-3 bg-light border rounded h-100">
                        <small class="text-body-secondary text-uppercase d-block">Fecha Finalización</small>
                        <strong>@Historial.FechaFinalizacion.ToString("dd/MM/yyyy")</strong>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="p-3 bg-light border rounded h-100">
                        <small class="text-body-secondary text-uppercase d-block">Técnico Asignado</small>
                        <strong>@ObtenerNombreTecnico(Historial.TecnicoId)</strong>
                    </div>
                </div>
                <div class="col-12">
                    <div class="p-3 bg-light border rounded">
                        <small class="text-body-secondary text-uppercase d-block">Dirección</small>
                        <strong>@Historial.Solicitud?.Direccion</strong>
                    </div>
                </div>
            </div>

            @* Historial de cambios *@
            <h6 class="fw-bold mb-3">Historial de cambios</h6>
            @if (!Historial.HistorialesDetalle.Any())
            {
                <p class="text-body-secondary mb-0">No hay cambios registrados para esta solicitud.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var cambio in Historial.HistorialesDetalle.OrderByDescending(d => d.Fecha))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start gap-3 px-0">
                            <div class="d-flex align-items-start gap-3">
                                <span class="badge bg-primary rounded-pill mt-1">&nbsp;</span>
                                <div>
                                    <strong>@cambio.Titulo</strong>
                                    <small class="text-body-secondary d-block">@cambio.Descripcion</small>
                                </div>
                            </div>
                            <small class="text-body-secondary text-nowrap">@cambio.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="card-footer text-center mt-2">
            <a href="/Historial/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int HistorialId { get; set; }

    public Historiales Historial { get; set; } = new Historiales();
    public List<INTECH.Data.ApplicationUser> ListaTecnicos { get; set; } = new List<INTECH.Data.ApplicationUser>();

    protected override async Task OnInitializedAsync()
    {
        var result = await historialesService.Buscar(HistorialId);
        result.OnSuccess(historial => Historial = historial ?? new Historiales());
        result.OnFailure(() => toastService.ShowError("No se pudo consultar el detalle del historial."));

        var tecnicos = await userManager.GetUsersInRoleAsync("Técnico");
        ListaTecnicos = tecnicos.ToList();
    }

    private string ObtenerNombreTecnico(string? tecnicoId)
    {
        if (string.IsNullOrWhiteSpace(tecnicoId))
        {
            return "Sin asignar";
        }

        return ListaTecnicos.FirstOrDefault(t => t.Id == tecnicoId)?.UserName ?? "Sin asignar";
    }
}
