@page "/Tecnico/Inicio"
@attribute [Authorize(Roles = "Técnico")]

<PageTitle>Inicio | INTECH</PageTitle>

<h1 class="h3 fw-bold">¡Bienvenido, @Nombre!</h1>
<p class="text-body-secondary mb-4">Resumen de la operación de hoy.</p>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <section class="card border-0 rounded-3 h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-2 p-3">
                <h2 class="small fw-normal text-body-secondary mb-0">Solicitudes pendientes</h2>
                <span class="fs-2 fw-bold text-primary">0</span>
                <a href="/Solicitud/Index" class="small">Ver solicitudes <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
            </div>
        </section>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <section class="card border-0 rounded-3 h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-2 p-3">
                <h2 class="small fw-normal text-body-secondary mb-0">Visitas programadas</h2>
                <span class="fs-2 fw-bold text-primary">0</span>
                <a href="/Agenda/Index" class="small">Ver agenda <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
            </div>
        </section>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <section class="card border-0 rounded-3 h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-2 p-3">
                <h2 class="small fw-normal text-body-secondary mb-0">Levantamientos pendientes</h2>
                <span class="fs-2 fw-bold text-primary">0</span>
                <a href="/Levantamiento/Index" class="small">Ver levantamientos <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
            </div>
        </section>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <section class="card border-0 rounded-3 h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-2 p-3">
                <h2 class="small fw-normal text-body-secondary mb-0">Órdenes de trabajo nuevas</h2>
                <span class="fs-2 fw-bold text-primary">0</span>
                <a href="/OrdenTrabajo/Index" class="small">Ver órdenes <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
            </div>
        </section>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-xl-7">
        <section class="card border-0 rounded-3 h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-3 p-3 p-lg-4">
                <h2 class="h5 fw-bold mb-0">Próxima visita</h2>
                <div class="d-flex flex-column justify-content-center align-items-start gap-2 py-4">
                    <span class="bi bi-calendar-week fs-2 text-primary" aria-hidden="true"></span>
                    <p class="text-body-secondary mb-0">No hay visitas programadas.</p>
                    <a href="/Agenda/Index" class="btn btn-outline-dark">Ver agenda</a>
                </div>
            </div>
        </section>
    </div>
    <div class="col-12 col-xl-5">
        <section class="card border-0 rounded-3 h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-3 p-3 p-lg-4">
                <h2 class="h5 fw-bold mb-0">Actividad reciente</h2>
                <div class="d-flex flex-column justify-content-between gap-3 flex-grow-1">
                    <p class="text-body-secondary my-3">No hay actividades registradas.</p>
                    <a href="/Historial/Index" class="small">Ver todas las actividades <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
                </div>
            </div>
        </section>
    </div>
</div>

<section>
    <h2 class="h5 fw-bold mb-3">Accesos rápidos</h2>
    <div class="row row-cols-1 row-cols-lg-5 g-3">
        <div class="col d-flex">
            <a href="/Solicitud/Create" class="btn btn-light bg-white border-0 rounded-3 shadow-sm p-3 fw-bold d-flex align-items-center justify-content-center gap-2 w-100 h-100">
                <span class="bi bi-file-earmark-text fs-4 text-primary" aria-hidden="true"></span> Nueva solicitud
            </a>
        </div>
        <div class="col d-flex">
            <a href="/Agenda/Create" class="btn btn-light bg-white border-0 rounded-3 shadow-sm p-3 fw-bold d-flex align-items-center justify-content-center gap-2 w-100 h-100">
                <span class="bi bi-calendar-plus fs-4 text-primary" aria-hidden="true"></span> Crear visita
            </a>
        </div>
        <div class="col d-flex">
            <a href="/Levantamiento/Create" class="btn btn-light bg-white border-0 rounded-3 shadow-sm p-3 fw-bold d-flex align-items-center justify-content-center gap-2 w-100 h-100">
                <span class="bi bi-compass fs-4 text-primary" aria-hidden="true"></span> Nuevo levantamiento
            </a>
        </div>
        <div class="col d-flex">
            <a href="/OrdenTrabajo/Index" class="btn btn-light bg-white border-0 rounded-3 shadow-sm p-3 fw-bold d-flex align-items-center justify-content-center gap-2 w-100 h-100">
                <span class="bi bi-clipboard-check fs-4 text-primary" aria-hidden="true"></span> Órdenes de trabajo
            </a>
        </div>
        <div class="col d-flex">
            <a href="/Cliente/Index" class="btn btn-light bg-white border-0 rounded-3 shadow-sm p-3 fw-bold d-flex align-items-center justify-content-center gap-2 w-100 h-100">
                <span class="bi bi-people fs-4 text-primary" aria-hidden="true"></span> Clientes
            </a>
        </div>
    </div>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    public string? Nombre { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            Nombre = authState.User.FindFirst("NombreCompleto")?.Value ?? authState.User.Identity?.Name;
        }
    }
}
