@page "/Servicio/Edit/{ServicioId:int}"
@attribute [Authorize(Roles = "Gerente")]

@inject ServiciosService serviciosService
@inject CategoriasServiciosService categoriasServiciosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Servicio</PageTitle>
<EditForm Model="Servicio" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Servicio</h5>
            </div>

            <div class="card-body">

                @* Categoría *@
                <div class="mb-3">
                    <label class="form-label"><strong>Categoría</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Servicio.CategoriaServicioId">
                        <option value="0" disabled>Elija una Categoría</option>
                        @foreach (var categoriaServicio in ListaCategoriasServicios)
                        {
                            <option value="@categoriaServicio.CategoriaServicioId">@categoriaServicio.Nombre</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Servicio.CategoriaServicioId)" />
                </div>

                @* Nombre *@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombre</strong></label>
                    <InputText class="form-control" @bind-Value="Servicio.Nombre" placeholder="Ej.: Instalación de Paneles Solares"></InputText>
                    <ValidationMessage For="(() => Servicio.Nombre)" />
                </div>

                @* Activo *@
                <div class="mb-3 form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="Servicio.Activo"></InputCheckbox>
                    <label class="form-check-label"><strong>Activo</strong></label>
                </div>

            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Servicio/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminarServicio"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarServicio" tabindex="-1" aria-labelledby="modalEliminarServicioLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarServicioLabel">Eliminar Servicio</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar este servicio?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    [Parameter]
    public int ServicioId { get; set; }

    public Servicios Servicio { get; set; } = new Servicios();
    public List<CategoriasServicios> ListaCategoriasServicios { get; set; } = new List<CategoriasServicios>();

    protected override async Task OnInitializedAsync()
    {
        var result = await serviciosService.Buscar(ServicioId);
        result.OnSuccess(servicio => Servicio = servicio ?? new Servicios());

        var categoriasServiciosResult = await categoriasServiciosService.GetList(c => true);
        categoriasServiciosResult.OnSuccess(categoriasServicios => ListaCategoriasServicios = categoriasServicios);
        categoriasServiciosResult.OnFailure(() => toastService.ShowError("No se pudieron consultar las categorías."));
    }

    public async Task Modificar()
    {
        Servicio.Nombre = Servicio.Nombre.Trim();

        if (await serviciosService.ExisteNombre(Servicio.Nombre, Servicio.ServicioId))
        {
            toastService.ShowError("Ya existe un servicio con ese nombre.");
            return;
        }

        var result = await serviciosService.Guardar(Servicio);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Servicio modificado correctamente.");
            navigationManager.NavigateTo("/Servicio/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo modificar el servicio."));
    }

    private async Task Eliminar()
    {
        var result = await serviciosService.Eliminar(ServicioId);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Servicio eliminado correctamente.");
            navigationManager.NavigateTo("/Servicio/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar el servicio."));
    }
}
