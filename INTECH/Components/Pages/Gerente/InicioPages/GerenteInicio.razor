@page "/Gerente/Inicio"
@attribute [Authorize(Roles = "Gerente")]

@inject ServiciosService serviciosService
@inject CategoriasServiciosService categoriasServiciosService
@inject ToastService toastService

<PageTitle>Inicio | INTECH</PageTitle>

<h1 class="h3 fw-bold">¡Bienvenido, @Nombre!</h1>
<p class="text-body-secondary mb-4">Resumen de la operación de hoy.</p>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <section class="card border-0 rounded-3 h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-2 p-3">
                <h2 class="small fw-normal text-body-secondary mb-0">Servicios registrados</h2>
                <span class="fs-2 fw-bold text-primary">@ListaServicios.Count</span>
                <a href="/Servicio/Index" class="small">Ver servicios <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
            </div>
        </section>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <section class="card border-0 rounded-3 h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-2 p-3">
                <h2 class="small fw-normal text-body-secondary mb-0">Servicios activos</h2>
                <span class="fs-2 fw-bold text-primary">@ListaServicios.Count(s => s.Activo)</span>
                <a href="/Servicio/Index" class="small">Ver servicios <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
            </div>
        </section>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <section class="card border-0 rounded-3 h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-2 p-3">
                <h2 class="small fw-normal text-body-secondary mb-0">Servicios inactivos</h2>
                <span class="fs-2 fw-bold text-primary">@ListaServicios.Count(s => !s.Activo)</span>
                <a href="/Servicio/Index" class="small">Ver servicios <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
            </div>
        </section>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <section class="card border-0 rounded-3 h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-2 p-3">
                <h2 class="small fw-normal text-body-secondary mb-0">Categorías de servicios</h2>
                <span class="fs-2 fw-bold text-primary">@ListaCategoriasServicios.Count</span>
                <a href="/Servicio/Index" class="small">Ver servicios <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
            </div>
        </section>
    </div>
</div>

<section>
    <h2 class="h5 fw-bold mb-3">Accesos rápidos</h2>
    <div class="row row-cols-1 row-cols-lg-5 g-3">
        <div class="col d-flex">
            <a href="/Servicio/Create" class="btn btn-light bg-white border-0 rounded-3 shadow-sm p-3 fw-bold d-flex align-items-center justify-content-center gap-2 w-100 h-100">
                <span class="bi bi-plus-square fs-4 text-primary" aria-hidden="true"></span> Nuevo servicio
            </a>
        </div>
        <div class="col d-flex">
            <a href="/Servicio/Index" class="btn btn-light bg-white border-0 rounded-3 shadow-sm p-3 fw-bold d-flex align-items-center justify-content-center gap-2 w-100 h-100">
                <span class="bi bi-tools fs-4 text-primary" aria-hidden="true"></span> Servicios
            </a>
        </div>
    </div>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    public string? Nombre { get; set; }

    public List<Servicios> ListaServicios { get; set; } = new List<Servicios>();
    public List<CategoriasServicios> ListaCategoriasServicios { get; set; } = new List<CategoriasServicios>();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            Nombre = authState.User.FindFirst("NombreCompleto")?.Value ?? authState.User.Identity?.Name;
        }

        var serviciosResult = await serviciosService.GetList(s => true);
        serviciosResult.OnSuccess(servicios => ListaServicios = servicios);
        serviciosResult.OnFailure(() => toastService.ShowError("No se pudieron consultar los servicios."));

        var categoriasServiciosResult = await categoriasServiciosService.GetList(c => true);
        categoriasServiciosResult.OnSuccess(categoriasServicios => ListaCategoriasServicios = categoriasServicios);
        categoriasServiciosResult.OnFailure(() => toastService.ShowError("No se pudieron consultar las categorías."));
    }
}
